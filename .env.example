# Salin menjadi .env.local (lokal) atau isi di Vercel → Project → Settings → Environment Variables.

# WAJIB di produksi: kunci untuk menandatangani sesi login admin (string acak panjang).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=ganti-dengan-string-acak-yang-panjang

# "true" bila situs diakses lewat HTTPS (Vercel selalu HTTPS).
COOKIE_SECURE=false

# --- Database ---------------------------------------------------------------
# Kosongkan untuk memakai file lokal storage/db.json (pengembangan / VPS).
# Isi untuk memakai PostgreSQL (WAJIB di Vercel). Contoh penyedia: Neon, Vercel Postgres, Supabase.
# Untuk Neon/Supabase gunakan connection string versi "pooled".
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Penyimpanan file unggahan ---------------------------------------------
# Kosongkan untuk menyimpan di storage/uploads (lokal / VPS).
# Isi untuk memakai Vercel Blob (WAJIB di Vercel). Dibuat otomatis saat Blob store dihubungkan ke project.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Lokasi folder data lokal (default ./storage)
# DATA_DIR=./storage
